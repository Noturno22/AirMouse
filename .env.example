# Copia este ficheiro para .env e preenche a chave do teu provider LLM.
# O Jarvis usa-ia para conversa por voz e para interpretar comandos por IA.
# Escolhe o provider em config.py -> llm_provider (groq | openai | deepseek |
# openrouter | ollama-local).

# Groq (recomendado: gratuito + muito rapido, bom para voz)
GROQ_API_KEY=gsk_...

# Ou alternativas (descomenta a que usares):
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
